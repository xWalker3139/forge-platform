{
  "title": "Forge service overview",
  "uid": "forge-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Requests / second", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum(rate(forge_http_requests_total[5m]))"}]},
    {"id": 2, "title": "p95 request duration (seconds)", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(forge_http_request_duration_seconds_bucket[5m])))"}]},
    {"id": 3, "title": "5xx ratio", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum(rate(forge_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(forge_http_requests_total[5m])), 0.001)"}]}
  ]
}
